{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "sourceMap": false
  },
  // Default config is editor / typecheck / lint friendly: it sees both
  // production source and integration tests so typescript-eslint can resolve
  // every file. Build emit is delegated to `tsconfig.build.json` to keep
  // `dist/` clean of test artifacts.
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts"]
}
