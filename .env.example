# Backend
BACKEND_PORT=3000
# Listen interface. Defaults to 127.0.0.1 (loopback only) so the
# un-authenticated dev backend isn't reachable from the LAN. Set to 0.0.0.0
# only when you intentionally want LAN/container exposure (and add upstream
# auth before doing so).
BACKEND_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173
OPENAI_API_KEY=sk-...replace-me...
SAFETY_ID_SALT=replace-with-random-32bytes-base64

# App
PUBLIC_BACKEND_URL=http://localhost:3000
